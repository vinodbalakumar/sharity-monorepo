{
  "name": "sharity-app",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 9174",
    "web": "expo start --web --port 9174",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:expo": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "build:e2e": "node tests/build-export.cjs",
    "test:assets": "node --test tests/image-size-compat.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/state": "^2.1.15",
    "@shopify/flash-list": "2.0.2",
    "@tamagui/config": "^2.1.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mmkv": "^4.3.1",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.5.1",
    "tamagui": "^2.1.0",
    "zeego": "^3.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.1.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~5.9.2",
    "image-size": "file:tools/image-size-compat",
    "image-size-engine": "npm:image-size@2.0.4"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "image-size": "$image-size",
    "@expo/ngrok": {
      "uuid": "^11.1.1"
    }
  }
}
