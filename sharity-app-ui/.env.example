# -----------------------------------------------------------------------------
# Expo app env file guide
#
# Files used by this project:
# - .env.development        versioned local Spring service defaults
# - .env.development.local  private workstation overrides
# - .env.local              private overrides for all environments
# - .env.qa / .env.prod      deployment presets (not auto-loaded by Expo)
#
# Script mapping:
# - npm start / npm run web -> Expo development env files, UI port 9174
# - npm run build:web       -> Expo production env files; development URLs excluded
# Export QA/production variables explicitly when using deployment presets.
# -----------------------------------------------------------------------------

# Public BFF root used by most authenticated app calls.
EXPO_PUBLIC_BFF_BASE_URL=http://localhost:9090/bff

# Public origin used by pages served outside the authenticated BFF prefix.
EXPO_PUBLIC_BFF_PUBLIC_BASE_URL=http://localhost:9090

# Auth endpoints used by login and token flows.
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:9093/authorization-server/api/v1/auth
EXPO_PUBLIC_AUTH_USER_BASE_URL=http://localhost:9090/bff/api/authorization-server/api/v1

# Marketplace and wallet endpoints used by dedicated feature modules.
EXPO_PUBLIC_MARKETPLACE_BASE_URL=http://localhost:9090/bff/public/marketplace-service/api/v1/marketplace
EXPO_PUBLIC_WALLET_BASE_URL=http://localhost:9090/bff/api/wallet-service/api/v1/wallet
