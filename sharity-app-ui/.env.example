# -----------------------------------------------------------------------------
# Expo app env file guide
#
# Files used by this project:
# - .env          shared defaults
# - .env.local    local workstation URLs
# - .env.qa       QA URLs
# - .env.prod     production URLs
#
# Script mapping:
# - npm run start       -> .env + .env.local
# - npm run start:qa    -> .env + .env.qa
# - npm run build:web   -> .env + .env.prod
# -----------------------------------------------------------------------------

# Public BFF root used by most authenticated app calls.
EXPO_PUBLIC_BFF_BASE_URL=http://localhost:8080/bff

# Public origin used by pages served outside the authenticated BFF prefix.
EXPO_PUBLIC_BFF_PUBLIC_BASE_URL=http://localhost:8080

# Auth endpoints used by login and token flows.
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:8083/authorization-server/api/v1/auth
EXPO_PUBLIC_AUTH_USER_BASE_URL=http://localhost:8080/bff/api/authorization-server/api/v1

# Marketplace and wallet endpoints used by dedicated feature modules.
EXPO_PUBLIC_MARKETPLACE_BASE_URL=http://localhost:8084/marketplace-service/api/v1/marketplace
EXPO_PUBLIC_WALLET_BASE_URL=http://localhost:8080/bff/api/wallet-service/api/v1/wallet
