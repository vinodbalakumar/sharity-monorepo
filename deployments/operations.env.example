# Apply matching values to every service process. Never commit real tokens.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_URL=http://localhost:8086/internal/diagnostics/events
DIAGNOSTICS_TOKEN=
DIAGNOSTICS_AI_ENABLED=false
DIAGNOSTICS_SLOW_MS=2000
AI_ENABLED=false
AI_CHAT_PROVIDER=none
OLLAMA_BASE_URL=http://192.168.0.149:11434
SPRING_AI_OLLAMA_CHAT_MODEL=qwen3:8b
AI_JWK_SET_URI=http://localhost:9093/authorization-server/api/oauth2/jwks
JWT_ISSUER=http://localhost:9093/authorization-server/api
JWT_AUDIENCE=auth-clients
OTEL_EXPORT_ENABLED=false
TRACING_SAMPLE_PROBABILITY=0.1
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# Development simulation only. Do not enable this on a real-money deployment.
COMMERCE_DEMO_PURCHASES_ENABLED=false
# Sharity AI public chat: same secret in BFF and AI only, never EXPO_PUBLIC_*.
CHAT_BFF_TOKEN=
FOUNDER_PUBLIC_EMAIL_APPROVED=false
# Use a dedicated MySQL database + reviewed chat-schema.sql in production.
# AI_DATABASE_URL=jdbc:mysql://private-db:3306/sharity_ai
# AI_DATABASE_USERNAME=sharity_ai
# AI_DATABASE_PASSWORD=
# AI_DATABASE_INIT=never
# Optional overrides for config/ai/application.properties; use Spring's direct environment bindings.
SPRING_AI_OLLAMA_CHAT_NUM_CTX=8192
SPRING_AI_OLLAMA_CHAT_NUM_PREDICT=1024
SPRING_AI_OLLAMA_CHAT_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=10m
